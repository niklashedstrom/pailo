{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/runtime/dist",
  "rewrites": [
    {
      "source": "/a/:slug/manifest.webmanifest",
      "destination": "https://edtgepobtmyogdmaphfm.supabase.co/functions/v1/app-manifest?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
