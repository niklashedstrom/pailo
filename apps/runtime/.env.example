# Copy to apps/runtime/.env.local for local development.
# Values for the local Supabase come from `supabase status`
# (API URL and the publishable key, sb_publishable_...).
# Only these two public values ever reach the browser; never put a
# secret or service role key here.
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
